// Firebase Storage rules for authenticated Offline-Salon administrators.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == 'your-admin-email@example.com'
          || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        );
    }

    match /sessions/{sessionId}/poster/{assetId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId}/artworks/{assetId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId}/decks/{assetId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && (
          (request.resource.contentType == 'application/pdf' && request.resource.size < 50 * 1024 * 1024)
          || (request.resource.contentType == 'image/jpeg' && request.resource.size < 2 * 1024 * 1024)
        );
      allow delete: if isAdmin();
    }
  }
}
